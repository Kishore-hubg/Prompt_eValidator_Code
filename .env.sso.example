# =============================================================================
# SSO Configuration for Prompt Validator WebUI
# =============================================================================

# OAuth Provider: "microsoft", "microsoft-entra-id", "azure-ad", "entra", or "mock-oauth"
PROMPT_VALIDATOR_OAUTH_PROVIDER=microsoft

# Microsoft Entra ID / Azure AD Settings
MICROSOFT_TENANT_ID=infovision.com
MICROSOFT_CLIENT_ID=12345678-1234-1234-1234-123456789012
MICROSOFT_ALLOWED_AUDIENCES=12345678-1234-1234-1234-123456789012

# Optional: Override defaults (usually not needed)
# MICROSOFT_ISSUER=https://login.microsoftonline.com/infovision.com/v2.0
# MICROSOFT_JWKS_URL=https://login.microsoftonline.com/infovision.com/discovery/v2.0/keys

# Allow mock OAuth for development (set to "false" in production)
PROMPT_VALIDATOR_ALLOW_MOCK_OAUTH=true

# =============================================================================
# Other Settings (existing configuration)
# =============================================================================

PROMPT_VALIDATOR_API_KEY=infovision-dev-key
DATABASE_BACKEND=mongodb
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB_NAME=prompt_validator

LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

SLACK_SIGNING_SECRET=your-slack-signing-secret

# Teams Bot Integration
BOT_APP_ID=your-teams-bot-app-id
BOT_APP_PASSWORD=your-teams-bot-password
BOT_APP_TENANT_ID=your-tenant-id
